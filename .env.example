# ── Evan AI Client — Environment Variables ────────────────────────────────
# Copy this to .env and fill in your values.

# Production API server URL (must be HTTPS for App Store builds)
EXPO_PUBLIC_API_URL=https://YOUR_SERVER_URL

# RevenueCat API keys (get from app.revenuecat.com → your app → API Keys)
EXPO_PUBLIC_RC_API_KEY_IOS=appl_REPLACE_WITH_YOUR_IOS_KEY
EXPO_PUBLIC_RC_API_KEY_ANDROID=goog_REPLACE_WITH_YOUR_ANDROID_KEY
