{
  "expo": {
    "name": "Evan AI",
    "slug": "evan-ai",
    "version": "1.0.0",
    "buildNumber": "1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evanai",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.evanai.app",
      "deploymentTarget": "16.0",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "192.168.1.227": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": false
            }
          }
        },
        "NSCameraUsageDescription": "Evan AI uses your camera to identify items and check their resale price instantly.",
        "NSPhotoLibraryUsageDescription": "Evan AI uses your photo library so you can scan items from your camera roll.",
        "NSPhotoLibraryAddUsageDescription": "Evan AI saves scan results to your photo library when you share a deal card.",
        "NSUserNotificationsUsageDescription": "Evan AI sends price drop alerts when items on your watchlist hit your target price.",
        "NSLocationWhenInUseUsageDescription": "Evan AI uses your location to show nearby deals and local thrift store heat maps.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "aps-environment": "production"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.evanai.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "react-native-vision-camera",
[
        "./plugins/withEvanWidget",
        {
          "bundleIdentifier": "com.evanai.app.EvanWidget",
          "targetName": "EvanWidget"
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_WITH_EAS_PROJECT_ID"
      }
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
