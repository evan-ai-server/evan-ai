  const normalizeListings = (raw, market, fallbackSource, query) => {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((it) => {
        const title =
          it?.title ||
          it?.name ||
          it?.productTitle ||
          it?.snippet ||
          it?.product_title ||
          query;

        const price =
          it?.price ??
          it?.extracted_price ??
          it?.price_value ??
          it?.value ??
          it?.salePrice ??
          it?.current_price ??
          null;
const url =
  it?.link ||
  it?.url ||
  it?.product_link ||
  it?.product_url ||
  null;

const isBadGoogle =
  typeof url === "string" &&
  url.includes("google.com/search") &&
  url.includes("ibp=oshop");

const safeUrl = isBadGoogle
  ? `https://www.google.com/search?q=${encodeURIComponent(title)}`
  : url;

        const image =
          it?.image ||
          it?.thumbnail ||
          it?.thumbnail_url ||
          it?.imageUrl ||
          it?.img ||
          null;

        const rating =
          it?.rating ??
          it?.stars ??
          it?.review_rating ??
          it?.reviews_rating ??
          it?.reviews ??
          null;

        const source = it?.source || fallbackSource;

const numericPrice = toNumber(price);
const ship = toNumber(it?.shipping ?? it?.shippingCost ?? it?.delivery ?? 0) || 0;

// all-in price: what user actually pays
const totalPrice = Number.isFinite(numericPrice) ? numericPrice + ship : null;

return {
  ...it,
  title,
  price,
  url: safeUrl,
  image,
  rating,
  source,
  __market: market, // "ebay" | "serp"
  numericPrice,
  shipping: ship,
  totalPrice,
};
      })
      .filter((x) => x?.title && x?.url && Number.isFinite(x?.numericPrice));
  };


const showSavedToast = (amount) => {
