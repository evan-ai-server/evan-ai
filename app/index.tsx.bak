};

// ===============================
// PRODUCTION SAFE FETCH WRAPPER
// ===============================

const fetchWithTimeout = async (url: string, options: any = {}, timeout = 15000) => {
  const controller = new AbortController();
  const id = setTimeout(() => controller.abort(), timeout);

  try {
    const res = await apiFetch(url, {
      ...options,
      signal: controller.signal,
      headers: {
        "Content-Type": "application/json",
        ...(options.headers || {}),
      },
    });

    clearTimeout(id);

    if (!res.ok) {
      const text = await res.text().catch(() => "");
      throw new Error(`API_${res.status}_${text.slice(0, 80)}`);
    }

    return res.json();
  } catch (err: any) {
    clearTimeout(id);

    if (err.name === "AbortError") {
      throw new Error("API_TIMEOUT");
    }

    throw err;
  }
};

// ===============================
// EXPONENTIAL RETRY WRAPPER
// ===============================

const safeApiCall = async (fn: () => Promise<any>, retries = 2) => {
  let attempt = 0;

  while (attempt <= retries) {
    try {
      return await fn();
    } catch (err) {
      if (attempt === retries) throw err;

      const delay = 600 * Math.pow(2, attempt);
      await new Promise((res) => setTimeout(res, delay));
      attempt++;
    }
  }
};

// ===============================
// CLIENT RATE LIMIT PROTECTION
// ===============================

const lastScanTimestampRef = useRef<number>(0);

const MIN_SCAN_INTERVAL = 2500; // 2.5 seconds hard minimum

const canTriggerScan = () => {
  const now = Date.now();

  if (now - lastScanTimestampRef.current < MIN_SCAN_INTERVAL) {
    return false;
  }

  lastScanTimestampRef.current = now;
  return true;
};

const stopLoadingSafely = () => {
  scanLockRef.current = false;

  setLoadingResults(false);
  setShowRetryWhileLoading(false);
  setLoadingPhotoUri(null);

  retryReveal.setValue(0);
};

const shippingCost = (item) => {
  if (typeof item.shipping === "number") return item.shipping;
  if (typeof item.shippingCost === "number") return item.shippingCost;
  return 0;
};

const conditionWeight = (condition) => {
  if (!condition) return 0.6;
  const c = condition.toLowerCase();
  if (c.includes("new")) return 0;
  if (c.includes("like new")) return 0.1;
  if (c.includes("excellent")) return 0.2;
  if (c.includes("good")) return 0.4;
  return 0.6;
};

// ===============================
// MAIN SCAN PIPELINE
// ===============================
const trackEvent = (event, payload = {}) => {
  if (!userId) return;
fetch(`${resolvedApiBase}/analytics/event`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
      userId,
      event,
      payload,
      ts: Date.now(),
    }),
  }).catch(() => {});
};

const runScan = async ({ photoUri, scannedPrice, countScan, forcedMode }) => {
if (!canTriggerScan()) {
  return;
}

const effectiveScanMode = forcedMode || scanMode;

  if (!isPro && scansUsed >= FREE_LIMIT) {
    setShowPaywall(true);
    return;
  }

  try {
    if (scanAbortRef.current) scanAbortRef.current.abort();
} catch (e) {}
  const controller = new AbortController();
  scanAbortRef.current = controller;

const startedAt = Date.now();
const maxWait =
  MIN_SCAN_MS +
  Math.random() * (MAX_SCAN_MS - MIN_SCAN_MS);

// HARD STOP: never load forever
const hardStopTimer = setTimeout(() => {
  try {
    scanAbortRef.current?.abort();
} catch (e) {}

  setShowRetryWhileLoading(true);
}, maxWait);

  const token = (scanTokenRef.current += 1);

scanSessionRef.current = {
  photoUri,
  scannedPrice,
  counted: !!countScan,
  startedAt: Date.now(),
  visionRetries: 0,
};

  setActiveResult(null);
  setResults([]);
  setSeeMoreListings([]);
  setLastScan(null);
  setShowRetryWhileLoading(false);

  setLoadingPhotoUri(photoUri);
  const sessionId = nextScanSession();
  setLoadingResults(true);
  setResultModalOpen(false);
  setTab("results");
  if (batchMode) {
  setBatchCount(c => c + 1);
  setTimeout(() => goTab?.("camera"), 800);
}
  try {
    const visionTimeout = withTimeout(7000, controller);

const photosToAnalyze =
  refinePhotos.length > 0 ? refinePhotos.map((p) => p.uri) : [photoUri];

const targets = photosToAnalyze.slice(0, 2);

const visionResults = await Promise.all(
  targets.map((uri) => analyzePhotoToQuery(uri, visionTimeout.signal))
);

const queries = [];
const confidences = [];

for (const v of visionResults) {
  if (v?.query) {
    queries.push(v.query);
    confidences.push(v.confidence || 0);
  }
}

const queryCounts = {};
queries.forEach((q) => (queryCounts[q] = (queryCounts[q] || 0) + 1));

// pick most common query from vision results
const rawVisionQuery =
  Object.entries(queryCounts)
    .sort((a, b) => b[1] - a[1])[0]?.[0] || null;

// clean up junk words and noise
const cleanVisionQuery = (q: any) => {
  if (!q) return "";

  let s = String(q).toLowerCase();

  s = s.replace(/[^a-z0-9 ]/g, " ");
  s = s.replace(/\s+/g, " ").trim();

  const bad = ["object", "item", "product", "unknown", "thing"];

  s = s
    .split(" ")
    .filter((w) => w.length > 2 && !bad.includes(w))
    .join(" ");

  return s;
};

const visionQuery = cleanVisionQuery(rawVisionQuery);

const rawVisionConfidence =
  confidences.length > 0
    ? confidences.reduce((a, b) => a + b, 0) / confidences.length
    : 0;

const visionConfidence = smoothConfidence(rawVisionConfidence);

if (!visionQuery || visionConfidence < CONFIDENCE_THRESHOLD) {
  // --- SAFE retry counter ---
  if (
    typeof scanSessionRef.current !== "object" ||
    scanSessionRef.current === null
  ) {
    scanSessionRef.current = {};
  }

  const retries = Number(scanSessionRef.current.visionRetries || 0);

  if (retries < MAX_VISION_RETRIES) {
    scanSessionRef.current.visionRetries = retries + 1;

    return runScan({
      photoUri,
      scannedPrice,
      countScan,
      forcedMode: scanMode,
    });
  }

  stopLoadingSafely();

setLastScan({
    kind: "low-confidence",
    confidence: visionConfidence,
    query: visionQuery,
  });
  return;
}


if (visionConfidence < CONFIDENCE_THRESHOLD) {
  // ✅ still continue (don’t hard-fail)
  setSavedToast("Low confidence — still searching…");
}

    const photoKey = await getImageCacheKey(photoUri);
    const cacheKey = `${effectiveScanMode}|${photoKey}`;


if (scanCacheRef.current.has(cacheKey)) {
  const cached = scanCacheRef.current.get(cacheKey);

  if (cached && Date.now() - cached.timestamp <= CACHE_TTL_MS) {
    const cachedCard = cached.card || null;
    const cachedTop3 = cached.results || [];

    setResults(cachedTop3);
    if (!isCurrentSession(sessionId)) return;
    setActiveResult(cachedCard);
    setLastScan(cached.lastScan || null);
    setTab("results");

    if (cachedCard && countScan && !scanLockRef.current) {
      scanLockRef.current = true;

      setScansUsed((prev) => prev + 1);

      if (Number.isFinite(cachedCard.savedAmount)) {
        setSavingsTotal((prev) => prev + cachedCard.savedAmount);
      }

setHistory((prev) => {
  const updated = [
    {
      id: `${Date.now()}`,
      uri: photoUri,
      title: cachedCard.itemName || "Scan",
      timestamp: new Date().toLocaleString(),
      resultCard: cachedCard,
    },
    ...prev,
  ];

  return updated;
});

    }

    stopLoadingSafely();
    return;
  }

  scanCacheRef.current.delete(cacheKey);
}

    if (token !== scanTokenRef.current) return;

    const marketController = new AbortController();
    const marketTimer = setTimeout(() => marketController.abort(), 12000);

const marketCacheKey = `${effectiveScanMode}|${visionQuery}`;
const cachedMarket = MARKET_CACHE.get(marketCacheKey);

let combined = null;

// Cache hit
if (cachedMarket && Date.now() - cachedMarket.ts <= CACHE_TTL_MS) {
  combined = cachedMarket.items;
} else {
  let ebayRaw = [];
  let serpRaw = [];
  let etsyRaw = [];

  try {
    const [ebayRes, serpRes, etsyRes] = await Promise.allSettled([
      fetchEbayResults(visionQuery, marketController.signal),
      searchSerp(visionQuery, marketController.signal),
      searchEtsy(visionQuery, marketController.signal),
    ]);

    ebayRaw = ebayRes.status === "fulfilled" ? ebayRes.value : [];
    serpRaw = serpRes.status === "fulfilled" ? serpRes.value : [];
    etsyRaw = etsyRes.status === "fulfilled" ? etsyRes.value : [];
  } finally {
    clearTimeout(marketTimer);
  }

combined = [
  ...normalizeListings(ebayRaw, "ebay", "eBay", visionQuery),
  ...normalizeListings(serpRaw, "serp", "Google", visionQuery),
  ...normalizeListings(etsyRaw, "etsy", "Etsy", visionQuery),
]
  .map((i) => {
    const price = parseMoney(i?.price);
    const shipping = parseMoney(i?.shipping);

    const total =
      Number.isFinite(price)
        ? Number.isFinite(shipping)
          ? price + shipping
          : price
        : NaN;

    return {
      ...i,
      numericPrice: price,
      numericShip: shipping,
      numericTotal: total,
      __titleNorm: String(i?.title || "")
        .toLowerCase()
        .replace(/\s+/g, " ")
        .trim(),
    };
  })
  .filter((i) => Number.isFinite(i.numericTotal))
  .sort((a, b) => a.numericTotal - b.numericTotal);

// --- dedupe duplicate marketplace spam ---
const seen = new Set();
const deduped = [];

for (const it of combined) {
  const key =
    String(it?.url || "") ||
    `${it.__titleNorm}|${it.numericTotal}|${it?.source || ""}`;

  if (!key) continue;
  if (seen.has(key)) continue;

  seen.add(key);
  deduped.push(it);
}

combined = deduped;

MARKET_CACHE.set(marketCacheKey, { ts: Date.now(), items: combined });
}

const top3 = combined.slice(0, 3);

// ✅ Populate "See more" for the modal immediately (first scan too)
setSeeMoreListings(combined.slice(0, 60));

if (top3.length === 0) {
  showUiError(
    "No matches found",
    "Try retaking the photo closer, or use Mark / Label mode for text-heavy items."
  );
  stopLoadingSafely();
  setTab("results");
  return;
}

    const cheapest = top3[0];
    const cheapestPrice = toNumber(cheapest.totalPrice ?? cheapest.price);
    const savedAmount = Math.max(0, scannedPrice - cheapestPrice);

    const cheaperPct =
  Number.isFinite(scannedPrice) && scannedPrice > 0
    ? ((scannedPrice - cheapestPrice) / scannedPrice) * 100
    : 0;

// -------------------------
// ✅ Market snapshot computation (STEP 5)
// -------------------------
const spread = getMarketSpread(combined);
const marketPrice = spread?.avg ?? cheapestPrice;

const stats = buildMarketStats(marketPrice);
const flipPotential = flipScore({
  scannedPrice,
  cheapestPrice,
  estimatedResale: stats.estimatedResale,
});

const wlMatch = (watchlistRef.current || []).find((x) => x.query === visionQuery);
const wlPoints = Array.isArray(wlMatch?.history)
  ? wlMatch.history.map((p) => toNumber(p?.best)).filter((n) => Number.isFinite(n))
  : [];

const category = inferCategory(visionQuery || cheapest.title);

const insights = computeInsights({
  scannedPrice,
  cheapestPrice,
  avgMarket: stats.avgMarket ?? marketPrice,
  low: spread?.low ?? stats.historicalLow,
  high: spread?.high ?? stats.historicalHigh,
  confidence: visionConfidence,
  totalMatches: combined.length,
  url: cheapest.url,
  historyPoints: wlPoints,
});

const card = {
  rankWhy: [
  "Lowest price across marketplaces",
  "High listing confidence",
  "Seller signals strong",
],
scanWhy: [
  "Vision matched brand + model",
