    if (splashInfoOpen) { setSplashInfoOpen(false); return true; }
    if (resultModalOpen) { setResultModalOpen(false); return true; }

    // If not on camera, go back to camera
    if (tab !== "camera") { goTab("camera"); return true; }

    return false; // allow OS to exit app
  });

  return () => sub.remove();
}, [
