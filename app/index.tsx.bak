    toValue: 1,
    duration: 200,
    useNativeDriver: true,
  }),
  Animated.timing(helpY, {
    toValue: 0,
    duration: 200,
    useNativeDriver: true,
  }),
]).start();

  Alert.alert(
    "Tips for better scans",
    "• Avoid glare and reflections\n• Fill the frame\n• Use good lighting\n• Capture logos or labels",
    [{ text: "Got it" }]
  );
};

const closeHelp = () => {
