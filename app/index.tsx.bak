const fetchEbayResults = async (query, signal) => {
  try {
    const res = await apiFetch(
      `${resolvedApiBase}/search/ebay?q=${encodeURIComponent(query)}`,
      { signal }
    );

    if (!res.ok) {
      console.warn("eBay non-200:", res.status);
      return [];
    }

    const text = await res.text();

    // Safety: backend sometimes returns HTML on error
    if (text.trim().startsWith("<")) {
      console.error("eBay returned HTML instead of JSON");
      return [];
    }

    return JSON.parse(text);
  } catch (e) {
    if (e?.name === "AbortError") throw e;
    console.error("eBay fetch failed", e);
    return [];
  }
};

// ✅ SerpAPI results (via your backend)
const searchSerp = async (query, signal) => {
  try {
const res = await apiFetch(`${resolvedApiBase}/market/search`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ query }),
      signal,
    });

    const data = await res.json();
    if (Array.isArray(data?.items)) return data.items;
    return [];
  } catch (e) {
    if (e?.name === "AbortError") throw e;
    console.error("Serp fetch failed", e);
    return [];
  }
};

