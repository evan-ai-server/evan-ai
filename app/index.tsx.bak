function StarRating({ value = 0, size = 14 }) {
  const v = Math.max(0, Math.min(5, Number(value) || 0));
  const full = Math.floor(v);
  const half = v - full >= 0.5;

  return (
    <View style={{ flexDirection: "row" }}>
      {Array.from({ length: 5 }).map((_, i) => {
        const idx = i + 1;

        const name =
          idx <= full
            ? "star"
            : half && idx === full + 1
            ? "star-half-full"
            : "star-o";

        return (
          <FontAwesome
            key={i}
            name={name}
            size={size}
            color="#F5C542"
          />
        );
      })}
    </View>
  );
}

