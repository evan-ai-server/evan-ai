// -------------------------
// ✅ FEATURE #14: Show Me Cheaper re-search
// -------------------------
const MIN_LOADING_MS = 2200;

const showMeCheaper = async () => {
  const q = activeResult?.visionQuery;
  if (!q) return;

  const startedAt = Date.now();

  hapticSelect();
  setLoadingResults(true);
  setShowRetryWhileLoading(false);

  const controller = new AbortController();

  try {

let data: any = null;
let lastErr: any = null;

for (let attempt = 0; attempt < 3; attempt++) {
  try {
    data = await safeApiCall(() =>
      fetchWithTimeout(`${resolvedApiBase}/market/research`, {
        method: "POST",
        signal: controller.signal,
        body: JSON.stringify({ query: q, mode: "cheaper" }),
      })
    );

    lastErr = null;
    break;
  } catch (e) {
    lastErr = e;

    if (attempt === 2) throw e;

    await new Promise(r =>
      setTimeout(r, attempt === 0 ? 300 : 700)
    );
  }
}

const items = Array.isArray(data?.items) ? data.items : [];

// Normalize + compute real total price
const qNorm = normalizeTitle(q);

const normalized = normalizeListings(items, "research", "Resale", q)
  .map((i) => {
    const price = parseMoney(i?.price);
    const shipping = parseMoney(i?.shipping);

    const total =
      Number.isFinite(price)
        ? Number.isFinite(shipping)
          ? Math.round((price + shipping) * 100) / 100
          : price
        : NaN;

    const titleNorm = normalizeTitle(i?.title || "");

    const simRaw = titleSimilarity(titleNorm, qNorm);
    const sim = Number.isFinite(simRaw) ? simRaw : 0;

    const score =
      sim * 0.7 +
      (1 / Math.max(total || 1, 1)) * 0.3;

    return {
      ...i,
      numericPrice: price,
      numericShip: shipping,
      numericTotal: total,
      __titleNorm: titleNorm,
      __sim: sim,
      __score: score,
    };
  })
  .filter((i) =>
    Number.isFinite(i.numericTotal) &&
    i.__sim > 0.35
  )
  .sort((a, b) => (b.__score || 0) - (a.__score || 0));

const seen = new Set();
const deduped = [];

for (const it of normalized) {
  const key =
    String(it?.url || "") ||
    `${it.__titleNorm}|${it.numericTotal}|${it?.source || ""}`;

  if (!key) continue;
  if (seen.has(key)) continue;

  seen.add(key);
  deduped.push(it);
}

const top3 = deduped.slice(0, 3);

if (top3.length) {
  setResults(top3);
  setSeeMoreListings(deduped.slice(0, 60));

  // update active card price to new best
}

  // update active card price to new best
const cheapest = top3[0];
if (!cheapest) {
  stopLoadingSafely();
  return;
}
const cheapestPrice = cheapest.numericTotal;

      setActiveResult((prev) => ({
        ...prev,
        price: cheapestPrice,
        store:
          cheapest.__market === "ebay"
            ? "eBay"
            : cheapest?.source || "Resale",
        buyLink: cheapest.url,
        image: cheapest.image || prev?.image,
        alternatives: top3,
        totalMatches: normalized.length,
      }));

// log weekly savings (local-first)
setIntelState((prev) => {
  const savedAmount = toNumber(
    (activeResult?.scannedPrice || 0) - cheapestPrice
  );

  const next = intelLog(prev, {
    type: "scan_saved",
    meta: { amount: Math.max(0, savedAmount) },
  });

  saveIntel(next);
  return next;
});

  } catch (e) {
    console.warn("showMeCheaper failed", e);
  } finally {
    const elapsed = Date.now() - startedAt;
    const remaining = Math.max(0, MIN_LOADING_MS - elapsed);

    setTimeout(() => {
      stopLoadingSafely();
    }, remaining);
  }
};

const onScanAnimFinished = () => {
  setScanAnimActive(false);
};

const retrySameScan = () => {
  const session = scanSessionRef.current;
  if (!session?.photoUri || !Number.isFinite(session?.scannedPrice)) {
    return;
  }

  hapticSelect();

  runScan({
    photoUri: session.photoUri,
    scannedPrice: session.scannedPrice,
    countScan: false,
  });
};
