),
  });

  saveIntel(next);
  return next;
});

} catch (e) {
  if (e?.name === "AbortError") {
    // cancel/hard-timeout path: keep it clean (no crash UI)
    stopLoadingSafely();
    return;
  }

  console.warn("runScan error:", e);

  setLastScan({
    kind: "error",
    message: "We couldn’t analyze this item. Try again.",
  });

  showUiError(
    "Scan failed",
    "Couldn’t reach marketplaces or Vision. Check your server + try again."
  );

  stopLoadingSafely();
} finally {
  clearTimeout(hardStopTimer);
}
};

  const handleUsePhoto = async () => {
    if (!photo?.uri) return;
    if (!canUsePhoto) return;

    const scannedPrice = toNumber(scanPriceInput);
    if (!Number.isFinite(scannedPrice) || scannedPrice <= 0) return;

    if (isFreeLimitReached) {
      setShowPaywall(true);
      return;
    }

    hapticSelect();
    setPriceSubmitted(true);
    Keyboard.dismiss();

const photoUri = photo.uri;

scanSessionRef.current = {
