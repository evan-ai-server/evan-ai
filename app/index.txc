    ]).start();

    const pic = await cameraRef.current.takePictureAsync({
      quality: 0.92, // slightly higher for Vision accuracy (no UI change)
      skipProcessing: Platform.OS === "android",
    });

    setPhoto(pic);
    setScanPriceInput("");
