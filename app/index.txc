            >
              <Text style={styles.modalSecondaryText}>Not now</Text>
            </Pressable>
              <Text style={styles.modalFoot}>
                Billing handled by the App Store. Cancel anytime in Apple ID settings.
              </Text>
          </View>
        </View>
      </Modal>

      {/* PROFILE MODAL: PAYMENTS */}
