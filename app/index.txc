        onRequestClose={() => setProfileModal(null)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>Payment methods</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setProfileModal(null);
                }}
