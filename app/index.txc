  useEffect(() => {
    (async () => {
      try {
        const payload = {
          scansUsed,
          cycleStartMs,
          isPro,
          history,
          isSignedIn,
          savingsTotal,
          activeResult,
          lastScan,
        };
        await AsyncStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      } catch (e) {}
    })();
  }, [
    scansUsed,
    cycleStartMs,
    isPro,
    history,
