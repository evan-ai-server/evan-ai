    pendingTabRef.current = next;

    Animated.timing(tabFade, {
      toValue: 0,
      duration: 170,
      easing: Easing.out(Easing.quad),
      useNativeDriver: true,
    }).start(() => {
      setTab(pendingTabRef.current);
      pendingTabRef.current = null;

      Animated.timing(tabFade, {
        toValue: 1,
        duration: 220,
        easing: Easing.out(Easing.cubic),
        useNativeDriver: true,
      }).start();
    });
  };

  // Camera roll picker
  const pickFromRoll = async () => {
    if (isFreeLimitReached) {
      setShowPaywall(true);
      return;
    }

    hapticSelect();

    const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (!perm.granted) return;

    const result = await ImagePicker.launchImageLibraryAsync({
      mediaTypes: ImagePicker.MediaTypeOptions.Images,
      quality: 0.92, // slightly higher for Vision accuracy (no UI change)
      allowsEditing: true,
      aspect: [4, 5],
    });

    if (!result.canceled && result.assets && result.assets[0]?.uri) {
      setPhoto({ uri: result.assets[0].uri });
      setScanPriceInput("");
      setPriceSubmitted(false);
      animateUseRetryIn();
    }
  };

  // Flip camera
  const flipCamera = () => {
    hideZoomHud();
    if (torchOn) setTorchOn(false);
    flashMask(220);
    if (flipTimer.current) clearTimeout(flipTimer.current);
    flipTimer.current = setTimeout(() => {
      setCameraFacing((prev) => (prev === "back" ? "front" : "back"));
    }, 120);
  };

  // Snap ring burst (not a flash)
  const playSnapRing = () => {
    ringScale.setValue(0.6);
    ringOpacity.setValue(0);

    Animated.parallel([
      Animated.timing(ringOpacity, {
        toValue: 1,
        duration: 70,
        useNativeDriver: true,
      }),
      Animated.timing(ringScale, {
        toValue: 1.35,
        duration: 220,
        easing: Easing.out(Easing.quad),
        useNativeDriver: true,
      }),
      Animated.timing(ringOpacity, {
        toValue: 0,
        duration: 260,
        easing: Easing.out(Easing.quad),
        useNativeDriver: true,
      }),
    ]).start();
  };

  const animateUseRetryIn = () => {
    buttonsY.setValue(90);
