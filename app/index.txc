  );

  const seeMoreLabel =
    (seeMoreListings?.length || 0) >= 10
      ? "See more (10+)"
      : `See more (${seeMoreListings?.length || 0})`;

const renderSmallResultCard = (item, idx) => {
  if (!item) return null;

  const store = item.__market === "ebay" ? "eBay" : item?.source || "Google";
  const price = toNumber(item.price);
  const rating =
    typeof item.rating === "number" ? item.rating : item.rating ?? null;
  const img = item.image || null;
  const url = item.url || null;

  return (
    <Pressable
      key={`${item?.url || idx}`}
      onPress={() => url && Linking.openURL(url)}
      style={({ pressed }) => [
        styles.miniCard,
        pressed && { opacity: 0.92, transform: [{ scale: 0.995 }] },
      ]}
    >
      <View style={{ flexDirection: "row", gap: 12, alignItems: "center" }}>
        {img ? (
          <Pressable onPress={() => setZoomUri(img)}>
            <Image source={{ uri: img }} style={styles.miniImg} />
          </Pressable>
        ) : (
          <View style={styles.miniImgFallback}>
            <Ionicons
              name="image-outline"
              size={18}
              color="rgba(255,255,255,0.65)"
            />
          </View>
        )}

        <View style={{ flex: 1 }}>
          <Text style={styles.miniTitle} numberOfLines={2}>
            {item.title || "Listing"}
          </Text>

          <View style={{ flexDirection: "row", alignItems: "center", marginTop: 6 }}>
            <Text style={styles.miniMeta}>
              {money(price)} · {store}
            </Text>

            {rating != null && (
              <View
                style={{
                  flexDirection: "row",
                  alignItems: "center",
                  marginLeft: 10,
                }}
              >
                <Ionicons
                  name="star"
                  size={13}
                  color="rgba(255,255,255,0.85)"
                />
                <Text style={styles.miniMeta}> {rating}</Text>
              </View>
            )}
          </View>
        </View>

        <Ionicons
          name="open-outline"
          size={18}
          color="rgba(255,255,255,0.85)"
        />
      </View>
    </Pressable>
  );
};

  return (
    <GestureHandlerRootView style={styles.container}>
      {showSplash ? (
        <SplashScreen
          opacity={splashOpacity}
          scale={logoScale}
          dotY={dotY}
          dotCount={splashDotCount}
        />
      ) : null}
      {/* ✅ FREE PASS INFO MODAL (tapping the pill opens this) */}
      <Modal
        visible={freePassInfoOpen}
        transparent
        animationType="fade"
        onRequestClose={() => setFreePassInfoOpen(false)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>Monthly free pass</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setFreePassInfoOpen(false);
                }}
                style={styles.backPill}
              >
                <Ionicons name="close" size={16} color="white" />
                <Text style={styles.backText}>Close</Text>
              </Pressable>
            </View>

            <Text style={styles.modalDesc}>
              You get {FREE_LIMIT} free scans every 30 days. You’ve used{" "}
              {Math.min(scansUsed, FREE_LIMIT)}/{FREE_LIMIT}.
            </Text>

            <Pressable
              onPress={() => {
                hapticSelect();
                setFreePassInfoOpen(false);
                setProfileModal("subscription");
              }}
              style={styles.modalPrimary}
            >
              <Text style={styles.modalPrimaryText}>Visit subscription</Text>
            </Pressable>

            <Pressable
              onPress={() => {
                hapticSelect();
                setFreePassInfoOpen(false);
              }}
              style={styles.modalSecondary}
            >
              <Text style={styles.modalSecondaryText}>Not now</Text>
            </Pressable>

            <View style={{ marginTop: 12 }}>
              <Text style={styles.modalFoot}>
                Billing handled by the App Store. Cancel anytime in Apple ID settings.
              </Text>
            </View>
          </View>
        </View>
      </Modal>

      {/* CAMERA SCREEN */}
      <Animated.View
        style={[
          styles.full,
          {
            opacity: tab === "camera" ? tabFade : 0,
            display: tab === "camera" ? "flex" : "none",
          },
        ]}
        pointerEvents={cameraPointerEvents}
      >
        <GestureDetector gesture={pinch}>
          <View style={{ flex: 1 }}>
            {/* CAMERA FEED */}
{tab === "camera" && (
  <AnimatedCameraView
    ref={cameraRef}
    style={styles.camera}
    facing={cameraFacing}
    animatedProps={cameraAnimatedProps}
    enableTorch={torchOn}
    onCameraReady={() => setCameraReady(true)}
  />
)}

            {/* Mask covers camera feed only */}
            <Animated.View
              pointerEvents="none"
              style={[
                StyleSheet.absoluteFillObject,
                {
                  backgroundColor: "black",
                  opacity: flashMaskOpacity,
                  zIndex: 2,
                },
              ]}
            />

            {/* UI Overlay */}
            <View
              style={[StyleSheet.absoluteFillObject, { zIndex: 3 }]}
              pointerEvents="box-none"
            >
              {/* ✅ FIX: pill is now tappable and opens the mini GUI */}
              <Pressable
                onPress={() => {
                  // Only show explainer when not Pro; keep UI identical otherwise.
                  if (!isPro) {
                    hapticSelect();
                    setFreePassInfoOpen(true);
                  }
                }}
                style={styles.demoPill}
              >
                <Text style={styles.demoText}>{demoLabel}</Text>
              </Pressable>

              <Pressable
                onPress={() => setTorchOn((p) => !p)}
                style={styles.torchBtn}
              >
                <Ionicons
                  name={torchOn ? "flash" : "flash-off"}
                  size={22}
                  color="white"
                />
              </Pressable>

              <View style={styles.frame} />

              {/* ZOOM HUD */}
              {!photo && cameraFacing === "back" ? (
                <Animated.View
                  pointerEvents="box-none"
                  style={{
                    position: "absolute",
                    top: 74,
                    alignSelf: "center",
                    alignItems: "center",
                    transform: [{ translateY: zoomHudY }],
                    opacity: zoomHudOpacity,
                  }}
                >
                  <View style={styles.zoomHudPill}>
                    <Text style={styles.zoomHudText}>{zoomHudText}</Text>
                  </View>
                </Animated.View>
              ) : null}

              {/* SNAP ZOOM BUTTONS */}
              {!photo && cameraFacing === "back" ? (
                <View style={styles.zoomRow}>
                  <Pressable
                    style={styles.zoomBtn}
                    onPress={() => setZoomLevel(1)}
                  > 
                    <Text style={styles.zoomBtnText}>1×</Text>
                  </Pressable>
                  <Pressable
                    style={styles.zoomBtn}
                    onPress={() => setZoomLevel(2)}
                  >
                    <Text style={styles.zoomBtnText}>2×</Text>
                  </Pressable>
                  <Pressable
                    style={styles.zoomBtn}
                    onPress={() => setZoomLevel(3)}
                  >
                    <Text style={styles.zoomBtnText}>3×</Text>
                  </Pressable>
                </View>
              ) : null}

              <Animated.Text
                style={[
                  styles.instruction,
                  { transform: [{ rotate: swayRotate }] },
                ]}
              >
                Frame the item 🚀
              </Animated.Text>

              {/* ACTION CONTROLS */}
              {!photo ? (
                <View style={styles.captureRow}>
                  <IconButton icon="images-sharp" onPress={pickFromRoll} />
                  <View style={styles.snapStack}>
                    <View style={styles.snapOuterRing} />
                    <Animated.View
                      style={[
                        styles.snapBurstRing,
                        {
                          opacity: ringOpacity,
                          transform: [{ scale: ringScale }],
                        },
                      ]}
                    />
                    <Pressable
                      onPress={takePhoto}
                      onPressIn={() =>
                        Animated.spring(snapScale, {
                          toValue: 1.06,
                          useNativeDriver: true,
                        }).start()
                      }
                      onPressOut={() =>
                        Animated.spring(snapScale, {
                          toValue: 1,
                          useNativeDriver: true,
                        }).start()
                      }
                      style={({ pressed }) => [
                        styles.snapPressable,
                        pressed && { opacity: 0.96 },
                      ]}
                    >
                      <Animated.View
                        style={[
                          styles.snapButton,
                          { transform: [{ scale: snapScale }] },
                        ]}
                      />
                    </Pressable>
                  </View>
                  <IconButton icon="camera-reverse-sharp" onPress={flipCamera} />
                </View>
              ) : null}

              {/* PREVIEW */}
              {photo ? (
                <View style={styles.previewOverlay}>
                  <Image
                    source={{ uri: photo.uri }}
                    style={styles.previewImage}
                  />

                  {/* Buttons ABOVE input + always above keyboard */}
                  <View
                    style={{
                      position: "absolute",
                      bottom: previewBottom,
                      width: "100%",
                      paddingHorizontal: 18,
                    }}
                  >
                    {/* ACTION BUTTONS — disappear after submit */}
                    {!priceSubmitted && !loadingResults ? (
                      <View style={styles.previewBtnsRow}>
                        <Pressable
                          onPress={reset}
                          style={({ pressed }) => [
                            styles.transparentBtn,
                            pressed && styles.illuminate,
                          ]}
                        >
                          <View style={styles.inlineRow}>
                            <Ionicons name="refresh" size={16} color="white" />
                            <Text style={styles.transparentBtnText}>
                              Retake
                            </Text>
                          </View>
                        </Pressable>

                        <Pressable
                          onPress={() => {
                            if (!canUsePhoto) return;
                            handleUsePhoto();
                          }}
                          style={({ pressed }) => [
                            styles.primaryBtn,
                            pressed && canUsePhoto && styles.illuminatePrimary,
                            !canUsePhoto && { opacity: 0.45 },
                          ]}
                        >
                          <View style={styles.inlineRow}>
                            <Ionicons name="search" size={16} color="white" />
                            <Text style={styles.primaryBtnText}>
                              Find cheaper
                            </Text>
                          </View>
                        </Pressable>
                      </View>
              ) : (
  <View style={{ marginBottom: 14 }}>
    <Text style={styles.mutedStrong}>
      {loadingResults ? "Searching…" : ""}
    </Text>

    <Text style={styles.modalFoot}>
      Billing handled by the App Store. Cancel anytime in Apple ID settings.
    </Text>
  </View>
)}

                    {/* PRICE INPUT */}
                    <Text style={styles.priceLabel}>Price you’re paying</Text>

                    <TextInput
                      value={scanPriceInput}
                      onChangeText={setScanPriceInput}
                      placeholder="$"
                      placeholderTextColor="rgba(255,255,255,0.4)"
                      keyboardType="numeric"
                      style={styles.priceInput}
                      onFocus={() => setPriceSubmitted(false)}
                      editable={!loadingResults}
                      returnKeyType="done"
                      onSubmitEditing={() => Keyboard.dismiss()}
                    />

                    <Text style={styles.previewHint}>
                      We’ll show the cheapest match and what you’d save.
                    </Text>
                  </View>
                </View>
              ) : null}
            </View>
          </View>
        </GestureDetector>
      </Animated.View>

      {/* RESULTS SCREEN */}
      <Animated.View
        style={[
          styles.full,
          {
            opacity: tab === "results" ? tabFade : 0,
            display: tab === "results" ? "flex" : "none",
          },
        ]}
        pointerEvents={tab === "results" ? "auto" : "none"}
      >
        <View style={styles.page}>
          <View style={styles.resultsHeaderRow}>
            <Text style={styles.pageTitle}>Results</Text>

            <Pressable
              onPress={() => goTab("camera")}
              style={({ pressed }) => [
                styles.signInBtn,
                pressed && styles.tabPressed,
              ]}
            >
              <Ionicons name="camera-outline" size={18} color="white" />
              <Text style={styles.signInText}>New scan</Text>
            </Pressable>
          </View>

          <Text style={styles.resultsSubcopy}>
            Top 3 cheapest matches — plus your savings.
          </Text>

          {/* LOADING */}
          {loadingResults ? (
            <View style={styles.loadingStage}>
              {/* blurred photo background */}
              {loadingPhotoUri ? (
                <View style={StyleSheet.absoluteFillObject}>
                  <Image
                    source={{ uri: loadingPhotoUri }}
                    style={StyleSheet.absoluteFillObject}
                    resizeMode="cover"
                    blurRadius={14}
                  />
                  <View
                    style={[
                      StyleSheet.absoluteFillObject,
                      { backgroundColor: "rgba(0,0,0,0.35)" },
                    ]}
                  />
                  <View
                    style={[
                      StyleSheet.absoluteFillObject,
                      { backgroundColor: "rgba(0,0,0,0.45)" },
                    ]}
                  />
                  <View
                    style={[
                      StyleSheet.absoluteFillObject,
                      { backgroundColor: "rgba(0,0,0,0.25)" },
                    ]}
                  />
                </View>
              ) : null}

              {/* foreground */}
              <View style={styles.loadingCard}>
                <RingSpinner size={44} />

                <Text style={styles.loadingTitle}>
                  {getLoadingCopy()}
                  {loadingDots}
                </Text>

                <Text style={styles.loadingHint}>
                  Searching the web for cheaper matches.
                </Text>

                {loadingTick > 9000 ? (
                  <Text style={styles.loadingSlow}>
                    Network slow? Retry won’t use a scan.
                  </Text>
                ) : null}

                <View style={styles.loadingBtnsRow}>
                  <Pressable
                    onPress={cancelActiveScan}
                    style={({ pressed }) => [
                      styles.secondaryActionBtn,
                      pressed && styles.tabPressed,
                    ]}
                  >
                    <Ionicons
                      name="close-circle-outline"
                      size={18}
                      color="white"
                    />
                    <Text style={styles.secondaryActionText}>Cancel</Text>
                  </Pressable>

                  <Animated.View
                    style={{
                      opacity: retryReveal,
                      transform: [{ scale: retryScale }],
                    }}
                    pointerEvents={showRetryWhileLoading ? "auto" : "none"}
                  >
                    <Pressable
                      onPress={retrySameScan}
                      style={({ pressed }) => [
                        styles.primaryActionBtn,
                        pressed && styles.illuminatePrimary,
                      ]}
                    >
                      <Ionicons name="refresh" size={18} color="white" />
                      <Text style={styles.primaryActionText}>Retry</Text>
                    </Pressable>
                  </Animated.View>

                  {!showRetryWhileLoading ? <View style={{ width: 96 }} /> : null}
                </View>
              </View>
            </View>
          ) : activeResult ? (
            <Animated.View
              style={{
                opacity: resultEntry,
                transform: [
                  {
                    translateY: resultEntry.interpolate({
                      inputRange: [0, 1],
                      outputRange: [14, 0],
                    }),
                  },
                ],
              }}
            >
              <Pressable
                onPress={() => {
                  if (activeResult.buyLink)
                    Linking.openURL(activeResult.buyLink);
                }}
                style={({ pressed }) => [
                  styles.resultCard,
                  pressed && { opacity: 0.92, transform: [{ scale: 0.995 }] },
                ]}
              >
                {activeResult.image ? (
                  <Image
                    source={{ uri: activeResult.image }}
                    style={styles.heroImg}
                  />
                ) : null}

                <Text style={styles.resultTitle}>{activeResult.itemName}</Text>

                <View style={styles.logoRow}>
                  <LogoChip
                    uri={LOGO_URIS.ebay}
                    label="eBay"
                    dim={activeResult.store !== "eBay"}
                  />
                  <LogoChip
                    uri={LOGO_URIS.google}
                    label="Google"
                    dim={activeResult.store === "eBay"}
                  />
                  <LogoChip
                    uri={LOGO_URIS.nike}
                    label="Nike"
                    dim={!nikeLikely}
                  />
                </View>

                <View
                  style={{
                    flexDirection: "row",
                    alignItems: "center",
                    marginTop: 8,
                  }}
                >
                  <Text style={styles.resultMeta}>
                    {money(activeResult.price)} · {activeResult.store} ·{" "}
                  </Text>
                  <Ionicons
                    name="star"
                    size={14}
                    color="rgba(255,255,255,0.85)"
                  />
                  <Text style={styles.resultMeta}> {activeResult.rating}</Text>
                </View>

                <ConfidenceBar value={activeResult.visionConfidence} />

                <View style={{ marginTop: 14 }}>
                  <Text style={styles.savedBig}>
                    Saved {money(activeResult.savedAmount)}
                  </Text>
                  <Text style={styles.savedSmall}>
                    {percent(activeResult.cheaperPct)} cheaper than{" "}
                    {money(activeResult.scannedPrice)}
                  </Text>
                </View>

                <View style={styles.marketBox}>
                  <Text style={styles.marketTitle}>Market snapshot</Text>

                  <Text style={styles.marketLine}>
                    Range: {money(activeResult.historicalLow)} –{" "}
                    {money(activeResult.historicalHigh)}
                  </Text>
                  <Text style={styles.marketLine}>
                    Avg: {money(activeResult.avgMarket)}
                  </Text>
                  <Text style={styles.marketLine}>
                    Resale est.: {money(activeResult.estimatedResale)}
                  </Text>
                  <Text style={styles.marketLine}>
                    Flip grade: {activeResult.flipPotential}
                  </Text>
                </View>

                <View style={styles.resultActionsRow}>
                  {seeMoreListings?.length > 0 ? (
                    <Pressable
                      onPress={() => {
                        hapticSelect();
                        setSeeMoreOpen(true);
                      }}
                      style={({ pressed }) => [
                        styles.smallActionBtn,
                        pressed && styles.tabPressed,
                      ]}
                    >
                      <Ionicons name="list-outline" size={16} color="white" />
                      <Text style={styles.smallActionText}>{seeMoreLabel}</Text>
                    </Pressable>
                  ) : null}

                  <Pressable
                    onPress={() => {
                      hapticSelect();
                      const saved = Number.isFinite(activeResult?.savedAmount)
                        ? activeResult.savedAmount
                        : 0;

                      const scripts = [
                        `hey, i found the same item for ${money(
                          activeResult?.price
                        )} — could you do ${money(
                          Math.max(
                            0.01,
                            (activeResult?.scannedPrice || 0) - saved / 2
                          )
                        )} today?`,
                        `would you take ${money(
                          Math.max(
                            0.01,
                            (activeResult?.scannedPrice || 0) - saved
                          )
                        )}? i can pay right now.`,
                        `i’m ready to buy — if you can match ${money(
                          activeResult?.price
                        )} i’ll take it immediately.`,
                      ];

                      setHaggleLines(scripts);
                      setHaggleOpen(true);
                    }}
                    style={({ pressed }) => [
                      styles.smallActionBtn,
                      pressed && styles.tabPressed,
                    ]}
                  >
                    <Ionicons
                      name="chatbubble-ellipses-outline"
                      size={16}
                      color="white"
                    />
                    <Text style={styles.smallActionText}>Haggle mode</Text>
                  </Pressable>
                </View>

                <Text style={styles.tapHint}>Tap to open listing</Text>
              </Pressable>

              {Array.isArray(results) && results.length > 1 ? (
                <View style={{ marginTop: 12 }}>
                  <Text style={styles.sectionTitle}>More top matches</Text>
                  {results
                    .slice(1, 3)
                    .map((it, idx) => renderSmallResultCard(it, idx))}
                </View>
              ) : null}
            </Animated.View>
          ) : (
            <View style={styles.emptyCard}>
              {lastScan?.kind === "low_confidence" ? (
                <>
<Text style={styles.emptyTitle}>
                    Couldn’t confidently identify this item
</Text>

<Text style={styles.emptySub}>
  Try a clearer photo, better lighting, or a closer angle.
</Text>
<Text style={styles.emptyTitle}>Try a clearer photo</Text>
                  <Text style={styles.emptyBody}>
                    Get closer to the logo/model text and avoid glare. That
                    usually fixes it.
                  </Text>
                  <ConfidenceBar value={lastScan?.confidence ?? 0} />
                </>
              ) : lastScan?.kind === "error" ? (
                <>
                  <Text style={styles.emptyTitle}>Scan didn’t finish</Text>
                  <Text style={styles.emptyBody}>
                    Retry the same photo, or start a new scan.
                  </Text>
                </>
              ) : lastScan?.kind === "no_match" ? (
                <>
                  <Text style={styles.emptyTitle}>No cheaper match found</Text>
                  <Text style={styles.emptyBody}>
                    Try a different angle or include branding in the shot.
                  </Text>
                  {Number.isFinite(lastScan?.confidence) ? (
                    <ConfidenceBar value={lastScan?.confidence ?? 0} />
                  ) : null}
                </>
              ) : (
                <>
                  <Text style={styles.emptyTitle}>No results yet</Text>
                  <Text style={styles.emptyBody}>
                    Scan an item to compare prices instantly.
                  </Text>
                </>
              )}

              <View style={{ marginTop: 14 }}>
                <Pressable onPress={retrySameScan} style={styles.modalPrimary}>
                  <View style={styles.inlineRow}>
                    <Ionicons name="refresh" size={16} color="white" />
                    <Text style={styles.modalPrimaryText}>Retry same scan</Text>
                  </View>
                </Pressable>

                <Pressable
                  onPress={() => goTab("camera")}
                  style={styles.modalPrimary}
                >
                  <View style={styles.inlineRow}>
                    <Ionicons name="camera-outline" size={16} color="white" />
                    <Text style={styles.modalPrimaryText}>New scan</Text>
                  </View>
                </Pressable>

                <Pressable
                  onPress={() => goTab("history")}
                  style={styles.modalSecondary}
                >
                  <Text style={styles.modalSecondaryText}>View history</Text>
                </Pressable>
              </View>
            </View>
          )}

          <View style={{ marginTop: 14 }}>
            <Pressable
              onPress={() => goTab("history")}
              style={styles.profileBtn}
            >
              <View style={styles.inlineRow}>
                <Ionicons name="time-outline" size={18} color="white" />
                <Text style={styles.profileBtnText}>History</Text>
              </View>
            </Pressable>
          </View>
        </View>
      </Animated.View>

      {/* HISTORY */}
      <Animated.View
        style={[
          styles.full,
          {
            opacity: tab === "history" ? tabFade : 0,
            display: tab === "history" ? "flex" : "none",
          },
        ]}
        pointerEvents={tab === "history" ? "auto" : "none"}
      >
        <View style={styles.page}>
          <Text style={styles.pageTitle}>History</Text>

          <View style={styles.savingsBox}>
            <Text style={styles.savingsTitle}>
              Total saved: {money(savingsTotal)}
            </Text>
            <Text style={styles.savingsSub}>Savings across your scans.</Text>

            {!hasUnlimited ? (
              <Text style={styles.savingsSubStrong}>
                Free scans reset every 30 days.
              </Text>
            ) : null}

            </View>

          {history.length === 0 ? (
            <Text style={styles.muted}>No scans yet.</Text>
          ) : (
            <Animated.ScrollView
              style={{ marginTop: 8 }}
              contentContainerStyle={{ paddingBottom: 140 }}
              showsVerticalScrollIndicator={false}
            >
{history.map((h) => (
  <Pressable
    key={h.id}
    onPress={() => {
      if (h?.resultCard) {
        setActiveResult(h.resultCard);
        setResultModalOpen(true);
      }
    }}
    style={({ pressed }) => [
      styles.historyRow,
      pressed && { opacity: 0.9, transform: [{ scale: 0.99 }] },
    ]}
  >
    <Pressable
      onPress={(e) => {
        e.stopPropagation();
        openHistoryPreview(h.uri);
      }}
      hitSlop={6}
    >
      <Image
        source={{ uri: h.uri }}
        style={styles.historyThumb}
      />
    </Pressable>

    <View style={{ flex: 1 }}>
      <Text style={styles.historyTitle}>{h.title}</Text>
      <Text style={styles.historyTime}>{h.timestamp}</Text>
    </View>
  </Pressable>

              ))}
            </Animated.ScrollView>
          )}
        </View>
      </Animated.View>

      {/* PROFILE */}
      <Animated.View
        style={[
          styles.full,
          {
            opacity: tab === "profile" ? tabFade : 0,
            display: tab === "profile" ? "flex" : "none",
          },
        ]}
        pointerEvents={tab === "profile" ? "auto" : "none"}
      >
        <View style={styles.page}>
          <View style={styles.profileHeaderRow}>
            <View>
              <Text style={styles.pageTitle}>Profile</Text>
              <Text style={styles.subStatus}>{statusLabel}</Text>
            </View>

            <Pressable
              onPress={() => {
                hapticSelect();
                if (isSignedIn) {
                  setIsSignedIn(false);
                  setIsPro(false);
                  setShowPaywall(false);
                } else {
                  setAuthModalOpen(true);
                }
              }}
              style={({ pressed }) => [
                styles.signInBtn,
                pressed && styles.tabPressed,
              ]}
            >
              <Ionicons name="person-circle-outline" size={18} color="white" />
              <Text style={styles.signInText}>
                {isSignedIn ? "Sign out" : "Sign in"}
              </Text>
            </Pressable>
          </View>

          <Pressable
            style={styles.profileBtn}
            onPress={() => {
              hapticSelect();
              if (!isSignedIn) {
                setAuthModalOpen(true);
                return;
              }
              setProfileModal("subscription");
            }}
          >
            <View style={styles.inlineRow}>
              <Ionicons name="sparkles-outline" size={18} color="white" />
              <Text style={styles.profileBtnText}>Subscription</Text>
            </View>
          </Pressable>

          <Pressable
            style={styles.profileBtn}
            onPress={() => {
              hapticSelect();
              setProfileModal("payments");
            }}
          >
            <View style={styles.inlineRow}>
              <Ionicons name="card-outline" size={18} color="white" />
              <Text style={styles.profileBtnText}>Payment methods</Text>
            </View>
          </Pressable>

          <Pressable style={styles.profileBtn} onPress={openHelp}>
            <View style={styles.inlineRow}>
              <Ionicons name="help-circle-outline" size={18} color="white" />
              <Text style={styles.profileBtnText}>Help</Text>
            </View>
          </Pressable>

          <Pressable
            style={styles.profileBtn}
            onPress={() => {
              hapticSelect();
              setProfileModal("review");
            }}
          >
            <View style={styles.inlineRow}>
              <Ionicons name="star-outline" size={18} color="white" />
              <Text style={styles.profileBtnText}>Leave a review</Text>
            </View>
          </Pressable>

          <Pressable
            style={styles.profileBtn}
            onPress={() => {
              hapticSelect();
              setProfileModal("terms");
            }}
          >
            <View style={styles.inlineRow}>
              <Ionicons name="document-text-outline" size={18} color="white" />
              <Text style={styles.profileBtnText}>Terms of Service</Text>
            </View>
          </Pressable>

          {helpOpen ? (
            <Pressable style={styles.helpBackdrop} onPress={closeHelp}>
              <Animated.View
                style={[
                  styles.helpBox,
                  { opacity: helpOpacity, transform: [{ translateY: helpY }] },
                ]}
              >
                <Text style={styles.helpTitle}>Quick tips</Text>
                <Text style={styles.helpItem}>• Fill the frame with the item.</Text>
                <Text style={styles.helpItem}>
                  • Use strong lighting (avoid glare).
                </Text>
                <Text style={styles.helpItem}>
                  • Include branding/model text if possible.
                </Text>
                <Text style={styles.helpHint}>Tap anywhere to close</Text>
              </Animated.View>
            </Pressable>
          ) : null}
        </View>
      </Animated.View>

      {/* ✅ SEE MORE MODAL */}
      <Modal
        visible={seeMoreOpen}
        transparent
        animationType="fade"
        onRequestClose={() => setSeeMoreOpen(false)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>More matches</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setSeeMoreOpen(false);
                }}
                style={styles.backPill}
              >
                <Ionicons name="close" size={16} color="white" />
                <Text style={styles.backText}>Close</Text>
              </Pressable>
            </View>

            <Text style={styles.modalDesc}>
              Tap a listing to open it. (This won’t use another scan.)
            </Text>

            <ScrollView
              style={{ maxHeight: 420 }}
              showsVerticalScrollIndicator={false}
            >
              {(seeMoreListings || []).slice(0, 40).map((it, idx) => {
                const store =
                  it.__market === "ebay" ? "eBay" : it?.source || "Google";
                return (
                  <Pressable
                    key={`${it?.url || idx}`}
                    onPress={() => {
                      const u = it?.url;
                      if (u) Linking.openURL(u);
                    }}
                    style={({ pressed }) => [
                      styles.listingRow,
                      pressed && { opacity: 0.9, transform: [{ scale: 0.995 }] },
                    ]}
                  >
                    <View style={{ flex: 1 }}>
                      <Text style={styles.listingTitle} numberOfLines={2}>
                        {it?.title || "Listing"}
                      </Text>
                      <Text style={styles.listingMeta}>
                        {money(toNumber(it?.price))} · {store}
                      </Text>
                    </View>

                    <Ionicons
                      name="open-outline"
                      size={18}
                      color="rgba(255,255,255,0.85)"
                    />
                  </Pressable>
                );
              })}
            </ScrollView>
          </View>
        </View>
      </Modal>

      {/* ✅ HAGGLE MODE MODAL */}
      <Modal
        visible={haggleOpen}
        transparent
        animationType="fade"
        onRequestClose={() => setHaggleOpen(false)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>Haggle mode</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setHaggleOpen(false);
                }}
                style={styles.backPill}
              >
                <Ionicons name="close" size={16} color="white" />
                <Text style={styles.backText}>Close</Text>
              </Pressable>
            </View>

            <Text style={styles.modalDesc}>
              Quick scripts you can say in-store. Tap to copy.
            </Text>

            <View style={{ gap: 10 }}>
              {(haggleLines || []).map((line, i) => (
                <Pressable
                  key={`${i}`}
                  onPress={() => {
                    hapticSelect();
                    copyText(line);
                  }}
                  style={({ pressed }) => [
                    styles.haggleRow,
                    pressed && { opacity: 0.9, transform: [{ scale: 0.995 }] },
                  ]}
                >
                  <Text style={styles.haggleText}>{line}</Text>
                  <Ionicons
                    name="copy-outline"
                    size={18}
                    color="rgba(255,255,255,0.85)"
                  />
                </Pressable>
              ))}
            </View>

            <Text style={styles.modalFoot}>
              (Copy uses expo-clipboard if installed. If not, nothing breaks.)
            </Text>
          </View>
        </View>
      </Modal>

      {/* RESULT MODAL (reopen from history) */}
      <Modal
        visible={resultModalOpen}
        transparent
        animationType="fade"
        onRequestClose={() => setResultModalOpen(false)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>Cheapest exact match</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setResultModalOpen(false);
                }}
                style={styles.backPill}
              >
                <Ionicons name="close" size={16} color="white" />
                <Text style={styles.backText}>Close</Text>
              </Pressable>
            </View>

            {activeResult ? (
              <>
                <Text style={{ color: "white", fontWeight: "900", fontSize: 16 }}>
                  {activeResult.itemName}
                </Text>

                <View
                  style={{ flexDirection: "row", alignItems: "center", marginTop: 6 }}
                >
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                    }}
                  >
                    {money(activeResult.price)} · {activeResult.store} ·{" "}
                  </Text>
                  <Ionicons name="star" size={14} color="rgba(255,255,255,0.85)" />
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                    }}
                  >
                    {" "}
                    {activeResult.rating}
                  </Text>
                </View>

                <ConfidenceBar value={activeResult.visionConfidence ?? 0} />

                <View style={{ marginTop: 12 }}>
                  <Text style={{ color: "white", fontWeight: "900" }}>
                    Saved {money(activeResult.savedAmount)}
                  </Text>
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                      marginTop: 2,
                    }}
                  >
                    {percent(activeResult.cheaperPct)} cheaper than{" "}
                    {money(activeResult.scannedPrice)}
                  </Text>
                </View>

                <View
                  style={{
                    marginTop: 12,
                    paddingTop: 10,
                    borderTopWidth: 1,
                    borderTopColor: "rgba(255,255,255,0.10)",
                  }}
                >
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.9)",
                      fontWeight: "900",
                      marginBottom: 6,
                    }}
                  >
                    Market snapshot
                  </Text>
                  <Text style={{ color: "rgba(255,255,255,0.75)", fontWeight: "700" }}>
                    Range: {money(activeResult.historicalLow)} –{" "}
                    {money(activeResult.historicalHigh)}
                  </Text>
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                      marginTop: 2,
                    }}
                  >
                    Avg: {money(activeResult.avgMarket)}
                  </Text>
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                      marginTop: 2,
                    }}
                  >
                    Resale est.: {money(activeResult.estimatedResale)}
                  </Text>
                  <Text
                    style={{
                      color: "rgba(255,255,255,0.75)",
                      fontWeight: "700",
                      marginTop: 2,
                    }}
                  >
                    Flip grade: {activeResult.flipPotential}
                  </Text>
                </View>

                <Pressable
                  onPress={() => {
                    if (activeResult.buyLink) Linking.openURL(activeResult.buyLink);
                  }}
                  style={[styles.modalPrimary, { marginTop: 14 }]}
                >
                  <View style={styles.inlineRow}>
                    <Ionicons name="open-outline" size={16} color="white" />
                    <Text style={styles.modalPrimaryText}>Open listing</Text>
                  </View>
                </Pressable>
              </>
            ) : (
              <Text style={styles.modalDesc}>No result found.</Text>
            )}
          </View>
        </View>
      </Modal>

      {/* PROFILE MODAL: SUBSCRIPTION */}
      <Modal
        visible={profileModal === "subscription"}
        transparent
        animationType="fade"
        onRequestClose={() => setProfileModal(null)}
      >
        <View style={styles.modalBackdrop}>
          <View style={styles.modalCard}>
            <View style={styles.modalTopRow}>
              <Text style={styles.modalTitle}>Unlimited scans</Text>
              <Pressable
                onPress={() => {
                  hapticSelect();
                  setProfileModal(null);
                }}
                style={styles.backPill}
              >
                <Ionicons name="close" size={16} color="white" />
                <Text style={styles.backText}>Close</Text>
              </Pressable>
            </View>

