  const scanPriceNum = toNumber(scanPriceInput);
  const canUsePhoto = Number.isFinite(scanPriceNum) && scanPriceNum > 0;

  const previewBottom = keyboardHeight > 0 ? keyboardHeight + 18 : 170;

  const hideTabBar = !!photo || tab === "results";

const tierLabel = isPro ? "Pro" : "Free";
  const statusLabel = isSignedIn
    ? `Signed in · ${tierLabel}`
    : `Not signed in · ${tierLabel}`;

  const loadingPhotoUri = scanSessionRef.current?.photoUri || null;

  const retryScale = retryReveal.interpolate({
