  Animated.sequence([
    Animated.spring(toastAnim, { toValue: 1, useNativeDriver: true, friction: 7, tension: 90 }),
    Animated.delay(900),
    Animated.timing(toastAnim, { toValue: 0, duration: 220, useNativeDriver: true }),
  ]).start(() => setSavedToast(null));
};
