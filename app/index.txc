// -------------------------
// ✅ HAPTICS (SAFE OPTIONAL)
// -------------------------
let ExpoHaptics = null;
try {
  // eslint-disable-next-line global-require
  ExpoHaptics = require("expo-haptics");
} catch {}

const hapticSelect = () => {
  try {
    ExpoHaptics?.selectionAsync?.();
  } catch {}
};
const hapticShutter = () => {
  try {
    ExpoHaptics?.impactAsync?.(ExpoHaptics.ImpactFeedbackStyle.Medium);
  } catch {}
};
// ✅ NEW: tick when Retry appears
const hapticTick = () => {
  try {
    ExpoHaptics?.impactAsync?.(ExpoHaptics.ImpactFeedbackStyle.Light);
  } catch {}
};

// -------------------------
// ✅ OPTIONAL CLIPBOARD (SAFE)
// -------------------------
let ExpoClipboard = null;
try {
  // eslint-disable-next-line global-require
  ExpoClipboard = require("expo-clipboard");
} catch {}

const copyText = async (text) => {
  try {
    const t = String(text ?? "");
    if (ExpoClipboard?.setStringAsync) await ExpoClipboard.setStringAsync(t);
  } catch {}
};

