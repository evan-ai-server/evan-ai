      if (scanAbortRef.current) scanAbortRef.current.abort();
    } catch {}
    scanAbortRef.current = null;

    // invalidate any pending scan writes
    scanTokenRef.current += 1;

    setLoadingResults(false);
    setShowRetryWhileLoading(false);

    goTab("camera");
  };

  const normalizeListings = (raw, market, fallbackSource, query) => {
    if (!Array.isArray(raw)) return [];
    return raw
      .map((it) => {
        const title =
          it?.title ||
          it?.name ||
          it?.productTitle ||
          it?.snippet ||
          it?.product_title ||
          query;

        const price =
          it?.price ??
          it?.extracted_price ??
          it?.price_value ??
          it?.value ??
          it?.salePrice ??
          it?.current_price ??
          null;

        const url =
          it?.url ||
          it?.link ||
          it?.product_link ||
          it?.itemWebUrl ||
          it?.viewItemURL ||
          it?.viewItemURLForNaturalSearch ||
          it?.permalink ||
          null;

        const image =
          it?.image ||
          it?.thumbnail ||
          it?.thumbnail_url ||
          it?.imageUrl ||
          it?.img ||
          null;

        const rating =
          it?.rating ??
          it?.stars ??
          it?.review_rating ??
          it?.reviews_rating ??
          it?.reviews ??
          null;

        const source = it?.source || fallbackSource;

        const numericPrice = toNumber(price);

        return {
          ...it,
          title,
          price,
          url,
          image,
          rating,
          source,
          __market: market, // "ebay" | "serp"
          numericPrice,
        };
      })
      .filter((x) => x?.title && x?.url && Number.isFinite(x?.numericPrice));
  };

  const showSavedToast = (amount) => {
  if (!Number.isFinite(amount) || amount <= 0) return;

  const msg = `saved ${money(amount)}`;
