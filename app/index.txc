      }),
      Animated.timing(buttonsOpacity, {
        toValue: 1,
        duration: 380,
        easing: Easing.out(Easing.quad),
        useNativeDriver: true,
      }),
    ]).start();
  };

  // Take photo
  const takePhoto = async () => {
    if (!cameraRef.current) return;

    if (isFreeLimitReached) {
      setShowPaywall(true);
