      const cheapestSerp = pickCheapest(serpResults);
      const priceEbay = toNumber(cheapestEbay?.price);
      const priceSerp = toNumber(cheapestSerp?.price);

      const store =
        cheapest.__market === "ebay"
          ? "eBay"
          : cheapest?.source || "Google";

