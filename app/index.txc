const [zoomUri, setZoomUri] = useState(null);
const zoomAnim = useRef(new Animated.Value(0)).current;

  useEffect(() => {
    if (zoomUri) {
      zoomAnim.setValue(0);
      Animated.spring(zoomAnim, {
        toValue: 1,
        useNativeDriver: true,
        friction: 8,
        tension: 70,
      }).start();
    }
  }, [zoomUri]);

  // Splash screen
