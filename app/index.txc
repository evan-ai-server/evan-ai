const runScan = async ({ photoUri, scannedPrice, countScan }) => {
// count scan ONLY once per session for non-unlimited users
if (!isPro && scansUsed >= FREE_LIMIT) {
  setShowPaywall(true);
  setLoadingResults(false);
  return;
}

if (countScan) {
  // ✅ Unlimited only if subscribed (day pass removed)
  const unlimitedNow = isPro;

  if (!unlimitedNow) {
    setScansUsed((p) => Math.min(FREE_LIMIT, p + 1));
  }

  // mark session counted
  scanSessionRef.current = {
    ...(scanSessionRef.current || {}),
    photoUri,
    scannedPrice,
    counted: true,
    startedAt: Date.now(),
  };
}


const token = (scanTokenRef.current += 1);

if (!cameraReady) {
  console.log("Camera not ready — blocking scan");
  return;
}

// abort previous scan, start a new controller
try {
  if (scanAbortRef.current) scanAbortRef.current.abort();
} catch {}

const controller = new AbortController();
scanAbortRef.current = controller;

// ⏱️ hard timeouts
const visionTimeout = withTimeout(7000, controller); // vision max 7s

setLoadingResults(true);
setActiveResult(null);
setResults([]);
setLastScan(null);
setSeeMoreListings([]);

// go to results while searching
goTab("results");

try {
  // 1) Vision
  const { query, confidence } = await analyzePhotoToQuery(
    photoUri,
    visionTimeout.signal
  );
  visionTimeout.cancel?.();

  // ⏱ hard timeout for marketplaces (prevents infinite spinner)
  const marketController = new AbortController();
  const marketTimer = setTimeout(
    () => marketController.abort(),
    12000
  ); // 12s max

  const [ebayRes, serpRes, etsyRes] = await Promise.allSettled([
    fetchEbayResults(query, marketController.signal),
    searchSerp(query, marketController.signal),
    searchEtsy(query, marketController.signal),
  ]);

  const ebayRaw = ebayRes.status === "fulfilled" ? ebayRes.value : [];
  const serpRaw = serpRes.status === "fulfilled" ? serpRes.value : [];
  const etsyRaw = etsyRes.status === "fulfilled" ? etsyRes.value : [];

  clearTimeout(marketTimer);

  const cacheKey = query?.toLowerCase().trim();

if (cacheKey && scanCacheRef.current.has(cacheKey)) {
  const cached = scanCacheRef.current.get(cacheKey)!;

  if (Date.now() - cached.timestamp <= CACHE_TTL) {
    console.log("⚡ CACHE HIT:", cacheKey);

    setResults(cached.results);
    setActiveResult(cached.results[0] ?? null);

setLastScan({
      kind: "cached",
      confidence,
      query,
    });
    setLoadingResults(false);
    return;
}
  // expired cache
  scanCacheRef.current.delete(cacheKey);
}

// race safety: ignore stale responses
if (token !== scanTokenRef.current) return;

const thriftBias =
  /vintage|used|retro|original|made in usa|single stitch/i.test(query);

if (thriftBias) {
  console.log("🧵 THRIFT/VINTAGE BIAS APPLIED");
}

if (!query || confidence < CONFIDENCE_THRESHOLD) {
  setResults([]);
  setActiveResult(null);

  setLastScan({
    kind: "low_confidence",
    confidence: Number.isFinite(confidence) ? confidence : 0,
    query: null,
  });

  const now = new Date();
  setHistory((prev) => [
    {
      id: `${now.getTime()}`,
      uri: photoUri,
      title: "Scan (low confidence)",
      subtitle:
        confidence < 0.25
          ? "No recognizable branding or features detected"
          : "Try better lighting, angle, or logo visibility",
      timestamp: now.toLocaleString(),
      resultCard: null,
    },
    ...prev,
  ]);

  setLoadingResults(false);
  return;
}

} catch (e) {
  console.error("❌ Scan pipeline error:", e);

  setResults([]);
  setActiveResult(null);
  setLastScan({
    kind: "error",
    confidence: 0,
    query: null,
  });

  setLoadingResults(false);
  return;
}

  /vintage|used|retro|original|made in usa|single stitch/i.test(query);

if (thriftBias) {
  console.log("🧵 THRIFT/VINTAGE BIAS APPLIED");
}

const shippingCost = (item) => {
  if (typeof item.shipping === "number") return item.shipping;
  if (typeof item.shippingCost === "number") return item.shippingCost;
  return 0;
};

const conditionWeight = (condition) => {
  if (!condition) return 0.6;
  const c = condition.toLowerCase();
  if (c.includes("new")) return 0;
  if (c.includes("like new")) return 0.1;
  if (c.includes("excellent")) return 0.2;
  if (c.includes("good")) return 0.4;
  return 0.6;
};
      if (token !== scanTokenRef.current) return;

      const ebayResults = normalizeListings(ebayRaw, "ebay", "eBay", query);
      const serpResults = normalizeListings(serpRaw, "serp", "Google", query);
      // ✅ combine + sort + top3 (DON'T THROW AWAY RESULTS)
const etsyResults = normalizeListings(etsyRaw, "etsy", "Etsy", query);
const combined = [...ebayResults, ...serpResults, ...etsyResults];

combined.sort((a, b) => {
  const confidencePenalty = (1 - confidence) * 2;

  const aTotal =
    a.numericPrice +
    shippingCost(a) +
    conditionWeight(a.condition) +
    confidencePenalty;

  const bTotal =
    b.numericPrice +
    shippingCost(b) +
    conditionWeight(b.condition) +
    confidencePenalty;

  return aTotal - bTotal;
});

setActiveResult(combined[0] ?? null);
setResults(combined.slice(0, 3));

if (cacheKey) {
  scanCacheRef.current.set(cacheKey, {
    results: combined.slice(0, 3),
    timestamp: Date.now(),
  });
}

setLastScan({
  kind: "success",
  confidence,
  query,
});

const top3 = combined.slice(0, 3);
  combined.reduce((sum, i) => sum + i.numericPrice, 0) /
  combined.length;

  combined.length
    ? combined.reduce(
        (sum, i) => sum + (i.numericPrice || 0),
        0
      ) / combined.length
    : 0;
const avgPrice =
  combined.length
    ? combined.reduce(
        (sum, i) => sum + (i.numericPrice || 0),
        0
      ) / combined.length
    : 0;

const savings =
  avgPrice && top3[0]
    ? Math.max(0, avgPrice - top3[0].numericPrice)
    : 0;

const allForModal = combined.slice(0, 60);

setSeeMoreListings(allForModal);
setResults(top3);
if (cacheKey) {
  scanCacheRef.current.set(cacheKey, {
    results: top3,
    timestamp: Date.now(),
