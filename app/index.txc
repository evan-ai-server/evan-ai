  setLastScan({
    kind: "low_confidence",
    confidence: Number.isFinite(confidence) ? confidence : 0,
    query: null,
    title: confidence < 0.25 ? "Couldn’t identify item" : "No listings found",
savings: Number(savings.toFixed(2)),
    subtitle:
      confidence < 0.25
        ? "No recognizable branding or features detected"
        : "Try a clearer photo or a different angle",
  });

  const now = new Date();
  setHistory((prev) => [
    {
      id: `${now.getTime()}`,
      uri: photoUri,
      subtitle:
        confidence < 0.25
          ? "No recognizable branding or features detected"
          : "No listings returned — try a clearer photo",
      timestamp: now.toLocaleString(),
      resultCard: null,
    },
    ...prev,
  ]);

  setLoadingResults(false);
return;
}

      const cheapest = top3[0];

      // kept for debug parity
